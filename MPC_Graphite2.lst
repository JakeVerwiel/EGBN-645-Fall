G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  set r /USA, China, ROW/ ;
   2   
   3  set year /2020*2025/;
   4   
   5  parameter
   6  pbar(r),
   7  qbar_s(r) /USA 0, CHINA 37.95, ROW 62.05/,
   8  qbar_d(r) /USA 20.5, CHINA 10, ROW 69.5/,
   9  e_d /-0.58/,
  10  e_s /0.2/ ;
  11   
  12  table priceIndex(year,r)
  13           USA  CHINA  ROW
  14  2020     100     85   95
  15  2021     110     90  102
  16  2022     135    115  125
  17  2023     120    105  112
  18  2024     115     95  108
  19  2025     125    100  115
  20  ;
  21   
  22  pbar(r) = sum(year, priceIndex(year,r)) / card(year);
  23   
  24  qbar_d("row") = sum(r,qbar_s(r)) - qbar_d("USA") - qbar_d("China") ;
  25   
  26  parameter a(r), b(r),  c(r),  d(r);
  27   
  28  b(r) = pbar(r) / (e_d * qbar_d(r)) ;
  29  a(r) = pbar(r) - b(r) * qbar_d(r) ;
  30  d(r)$(qbar_s(r) > 0) = pbar(r) / (e_s * qbar_s(r));
  31  c(r)$(qbar_s(r) > 0) = pbar(r) - d(r) * qbar_s(r);
  32   
  33  * Potential US graphite producer
  34  c("USA") = 100;
  35  d("USA") = 2;
  36   
  37  scalar e;
  38  parameter tradeCost(r);
  39  tradeCost(r) = 0;
  40  tradeCost("China") = 10;
  41  tradeCost("ROW") = 10;
  42   
  43  positive variable Qd(r), Qs(r) ;
  44  positive variable X(r) "exports" ;
  45  Qs.fx("USA") = 0;
  46  X.fx("USA") = 0;
  47  variable W "total welfare" ;
  48   
  49  equation objfn, market_clearing(r) ;
  50   
  51  objfn.. W =e=
  52      sum(r, a(r)*Qd(r) + b(r)*sqr(Qd(r))/2
  53      - c(r)*Qs(r) - d(r)*sqr(Qs(r))/2)
  54      - sum(r, tradeCost(r)*X(r));
  55   
      market_clearing_usa.. Qd("USA") + X("USA") =e= Qs("USA") ;
      market_clearing_china.. Qd("China") + X("China") =e= Qs("China") ;
      market_clearing_row.. Qd("ROW") =e= Qs("ROW") + X("USA") + X("China")  ; 
  61   
  62  alias(r,rr);
  63   
  64  market_clearing(r)..
  65      Qs(r)
  66      + sum(rr$(not sameas(rr,"USA")), X(rr))$sameas(r,"USA")
  67      =g=
  68      Qd(r)
  69      + X(r)$(not sameas(r,"USA"));
  70   
  71  model simple /all/;
  72   
  73  solve simple using QCP maximizing W;
  74   
  75  set scenario /BAU/;
  76  set metric /Qd, Qs, P, Exports/;
  77   
  78  parameter rep(scenario,metric,r);
  79   
  80  rep("BAU","Qd",r) = Qd.l(r);
  81  rep("BAU","Qs",r) = Qs.l(r);
  82  rep("BAU","P",r) = -market_clearing.m(r);
  83  rep("BAU","Exports",r) = X.l(r);
  84   
  85   
  86  execute_unload 'rep_graphite_mcp.gdx' ;
  87   
  88   
  89   
  90  positive variable P(r) ;
  91   
  92  equation foc_qs(r), foc_qd(r), foc_x(r) ;
  93   
  94  foc_qs(r).. c(r) + d(r) * Qs(r) =g= P(r) ;
  95  foc_qd(r)..   P(r) =g= a(r)+b(r)*Qd(r) ;
  96  foc_x(r)$(not sameas(r,"USA"))..
  97      tradeCost(r) + P(r) =g= P("USA");
  98   
  99  model graphite_mcp
 100  /
 101  market_clearing.P,
 102  foc_qs.qs,
 103  foc_qd.qd,
 104  foc_x.X
 105  /;
 106   
 107  P.l(r) = max(0, -market_clearing.m(r));
 108   
 109  solve graphite_mcp using MCP;
 110   
 111  parameter results(*,*,r);
 112  parameter welfare(*);
 113   
 114  * Save baseline results
 115  results("Baseline","Price",r)   = P.l(r);
 116  results("Baseline","Demand",r)  = Qd.l(r);
 117  results("Baseline","Supply",r)  = Qs.l(r);
 118  results("Baseline","Exports",r) = X.l(r);
 119   
 120  welfare("Baseline") =
 121      sum(r,
 122          a(r)*Qd.l(r) + b(r)*sqr(Qd.l(r))/2
 123          - c(r)*Qs.l(r) - d(r)*sqr(Qs.l(r))/2
 124      )
 125      - sum(r, tradeCost(r)*X.l(r));
 126   
 127   
 128  * ==========================================
 129  * MILESTONE 1: CHINESE PRODUCTION EXPANSION
 130  * ==========================================
 131   
 132  set productionShock /S10, S20, S30, S40/;
 133   
 134  parameter shockPct(productionShock)
 135  /
 136  S10 0.10
 137  S20 0.20
 138  S30 0.30
 139  S40 0.40
 140  /;
 141   
 142  scalar baselineChinaProduction;
 143   
 144  parameter targetProduction(productionShock);
 145   
 146  * Save baseline Chinese production
 147  baselineChinaProduction = Qs.l("China");
 148   
 149  * ==========================================
 150  * RUN PRODUCTION EXPANSION SCENARIOS
 151  * ==========================================
 152   
 153  loop(productionShock,
 154   
 155  * Increase Chinese production
 156      Qs.fx("China") =
 157          baselineChinaProduction*(1+shockPct(productionShock));
 158   
 159      targetProduction(productionShock) =
 160          baselineChinaProduction*(1+shockPct(productionShock));
 161   
 162  * Solve new welfare equilibrium
 163      solve simple using QCP maximizing W;
 164   
 165  * Initialize equilibrium prices
 166      P.l(r) = max(0,-market_clearing.m(r));
 167   
 168  * Solve MCP equilibrium
 169      solve graphite_mcp using MCP;
 170   
 171  * Save scenario results
 172      results(productionShock,"Price",r) = P.l(r);
 173      results(productionShock,"Demand",r) = Qd.l(r);
 174      results(productionShock,"Supply",r) = Qs.l(r);
 175      results(productionShock,"Exports",r) = X.l(r);
 176   
 177  * Calculate welfare
 178      welfare(productionShock) =
 179          sum(r,
 180              a(r)*Qd.l(r)
 181              + b(r)*sqr(Qd.l(r))/2
 182              - c(r)*Qs.l(r)
 183              - d(r)*sqr(Qs.l(r))/2
 184          )
 185          - sum(r,tradeCost(r)*X.l(r));
 186   
 187  );
 188   
 189  * Restore Chinese production flexibility
 190  Qs.lo("China") = 0;
 191  Qs.up("China") = +inf;
 192   
 193  * ==========================================
 194  * DISPLAY MILESTONE 1 RESULTS
 195  * ==========================================
 196   
 197  display baselineChinaProduction;
 198  display targetProduction;
 199  display results;
 200  display welfare;
 201   
 202  execute_unload 'graphite_milestone1.gdx',
 203      results, welfare, targetProduction;
 204   
EXIT c:\Users\jverw\OneDrive\Documents\GitHub\EGBN 645 Fall\MPC_Graphite2.gms
