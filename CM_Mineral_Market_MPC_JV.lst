GAMS 54.3.1  61154be4 Aug 21, 2026          WEX-WEI x86 64bit/MS Windows - 10/12/26 17:31:37 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  set r /USA, China, ROW/ ;
   2   
   3  set year /2020*2025/;
   4   
   5  parameter
   6  pbar(r),
   7  qbar_s(r) /USA 0, CHINA 37.95, ROW 62.05/,
   8  qbar_d(r) /USA 20.5, CHINA 10, ROW 69.5/,
   9  e_d /-0.58/,
  10  e_s /0.2/ ;
  11   
  12  table priceIndex(year,r)
  13           USA  CHINA  ROW
  14  2020     100     85   95
  15  2021     110     90  102
  16  2022     135    115  125
  17  2023     120    105  112
  18  2024     115     95  108
  19  2025     125    100  115
  20  ;
  21   
  22  pbar(r) = sum(year, priceIndex(year,r)) / card(year);
  23   
  24  qbar_d("row") = sum(r,qbar_s(r)) - qbar_d("USA") - qbar_d("China") ;
  25   
  26  parameter a(r), b(r),  c(r),  d(r);
  27   
  28  b(r) = pbar(r) / (e_d * qbar_d(r)) ;
  29  a(r) = pbar(r) - b(r) * qbar_d(r) ;
  30  d(r)$(qbar_s(r) > 0) = pbar(r) / (e_s * qbar_s(r));
  31  c(r)$(qbar_s(r) > 0) = pbar(r) - d(r) * qbar_s(r);
  32   
  33  * Potential US graphite producer
  34  c("USA") = 100;
  35  d("USA") = 2;
  36   
  37  scalar e;
  38  parameter tradeCost(r);
  39  tradeCost(r) = 0;
  40  tradeCost("China") = 10;
  41  tradeCost("ROW") = 10;
  42   
  43  positive variable Qd(r), Qs(r) ;
  44  positive variable X(r) "exports" ;
  45  Qs.fx("USA") = 0;
  46  X.fx("USA") = 0;
  47  variable W "total welfare" ;
  48   
  49  equation objfn, market_clearing(r) ;
  50   
  51  objfn.. W =e=
  52      sum(r, a(r)*Qd(r) + b(r)*sqr(Qd(r))/2
  53      - c(r)*Qs(r) - d(r)*sqr(Qs(r))/2)
  54      - sum(r, tradeCost(r)*X(r));
  55   
      market_clearing_usa.. Qd("USA") + X("USA") =e= Qs("USA") ;
      market_clearing_china.. Qd("China") + X("China") =e= Qs("China") ;
      market_clearing_row.. Qd("ROW") =e= Qs("ROW") + X("USA") + X("China")  ; 
  61   
  62  alias(r,rr);
  63   
  64  market_clearing(r)..
  65      Qs(r)
  66      + sum(rr$(not sameas(rr,"USA")), X(rr))$sameas(r,"USA")
  67      =g=
  68      Qd(r)
  69      + X(r)$(not sameas(r,"USA"));
  70   
  71  model simple /all/;
  72   
  73  solve simple using QCP maximizing W;
  74   
  75  set scenario /BAU/;
  76  set metric /Qd, Qs, P, Exports/;
  77   
  78  parameter rep(scenario,metric,r);
  79   
  80  rep("BAU","Qd",r) = Qd.l(r);
  81  rep("BAU","Qs",r) = Qs.l(r);
  82  rep("BAU","P",r) = -market_clearing.m(r);
  83  rep("BAU","Exports",r) = X.l(r);
  84   
  85   
  86  execute_unload 'rep_graphite_mcp.gdx' ;
  87   
  88   
  89   
  90  positive variable P(r) ;
  91   
  92  equation foc_qs(r), foc_qd(r), foc_x(r) ;
  93   
  94  foc_qs(r).. c(r) + d(r) * Qs(r) =g= P(r) ;
  95  foc_qd(r)..   P(r) =g= a(r)+b(r)*Qd(r) ;
  96  foc_x(r)$(not sameas(r,"USA"))..
  97      tradeCost(r) + P(r) =g= P("USA");
  98   
  99  model graphite_mcp
 100  /
 101  market_clearing.P,
 102  foc_qs.qs,
 103  foc_qd.qd,
 104  foc_x.X
 105  /;
 106   
 107  P.l(r) = max(0, -market_clearing.m(r));
 108   
 109  solve graphite_mcp using MCP;
 110   
 111  parameter results(*,*,r);
 112  parameter welfare(*);
 113   
 114  * Save baseline results
 115  results("Baseline","Price",r)   = P.l(r);
 116  results("Baseline","Demand",r)  = Qd.l(r);
 117  results("Baseline","Supply",r)  = Qs.l(r);
 118  results("Baseline","Exports",r) = X.l(r);
 119   
 120  welfare("Baseline") =
 121      sum(r,
 122          a(r)*Qd.l(r) + b(r)*sqr(Qd.l(r))/2
 123          - c(r)*Qs.l(r) - d(r)*sqr(Qs.l(r))/2
 124      )
 125      - sum(r, tradeCost(r)*X.l(r));
 126   
 127  * ==========================================
 128  * SCENARIO 2: US ENTRY + CHINESE SUPPLY SHOCK
 129  * ==========================================
 130   
 131  * Allow the US company to produce graphite
 132  Qs.lo("USA") = 0;
 133  Qs.up("USA") = +inf;
 134   
 135  * China expands supply by lowering marginal cost
 136  c("China") = c("China") - 30;
 137   
 138  * Solve the new welfare equilibrium
 139  solve simple using QCP maximizing W;
 140   
 141  * Initialize MCP prices
 142  P.l(r) = max(0, -market_clearing.m(r));
 143   
 144  * Solve new market equilibrium
 145  solve graphite_mcp using MCP;
 146   
 147  * Save second scenario results
 148  results("US_China_Response","Price",r)   = P.l(r);
 149  results("US_China_Response","Demand",r)  = Qd.l(r);
 150  results("US_China_Response","Supply",r)  = Qs.l(r);
 151  results("US_China_Response","Exports",r) = X.l(r);
 152   
 153  welfare("US_China_Response") =
 154      sum(r,
 155          a(r)*Qd.l(r) + b(r)*sqr(Qd.l(r))/2
 156          - c(r)*Qs.l(r) - d(r)*sqr(Qs.l(r))/2
 157      )
 158      - sum(r, tradeCost(r)*X.l(r));
 159   
 160  * Compare both scenarios
 161  display results, welfare;
 162   
 163  execute_unload 'graphite_scenarios.gdx', results, welfare;
 164   
