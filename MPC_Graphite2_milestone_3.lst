G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * Graphite market model | 100 model units = 1.55 million tonnes per year
   2  set r /USA, China, ROW/ ;
   3   
   4  set year /2025/;
   5  parameter
   6  pbar(r),
   7  qbar_s(r) /USA 0,    CHINA 81.94, ROW 18.06/,
   8  qbar_d(r) /USA 4.21, CHINA 73.01, ROW 22.78/,
   9  e_d /-.58/ ,
  10  e_s /0.31/ ;
  11   
  12  * Regional reference prices in USD per metric tonne.
  13  table priceIndex(year,r)
  14           USA  CHINA  ROW
  15  2025     775   460   650
  16  ;
  17  pbar(r) = sum(year, priceIndex(year,r)) / card(year);
  18   
  19  qbar_d("row") = sum(r,qbar_s(r)) - qbar_d("USA") - qbar_d("China") ;
  20   
  21  parameter a(r), b(r),  c(r),  d(r);
  22  b(r) = pbar(r) / (e_d * qbar_d(r)) ;
  23  a(r) = pbar(r) - b(r) * qbar_d(r) ;
  24  d(r)$(qbar_s(r) > 0) = pbar(r) / (e_s * qbar_s(r));
  25  c(r)$(qbar_s(r) > 0) = pbar(r) - d(r) * qbar_s(r);
  26   
  27  * Potential U.S. graphite producer.
  28  c("USA") = 100;
  29  d("USA") = 2;
  30   
  31  scalar e;
  32  parameter tradeCost(r);
  33  tradeCost(r) = 0;
  34  tradeCost("China") = 315;
  35  tradeCost("ROW") = 125;
  36  scalar tradeCostChinaROW /190/;
  37  positive variable Xcr "China exports to ROW";
  38   
  39  positive variable Qd(r), Qs(r) ;
  40  positive variable X(r) "exports" ;
  41  Qs.fx("USA") = 0;
  42  X.fx("USA") = 0;
  43  variable W "total welfare" ;
  44   
  45  equation objfn, market_clearing(r) ;
  46  objfn.. W =e=
  47      sum(r, a(r)*Qd(r) + b(r)*sqr(Qd(r))/2
  48      - c(r)*Qs(r) - d(r)*sqr(Qs(r))/2)
  49      - sum(r, tradeCost(r)*X(r))
  50      - tradeCostChinaROW*Xcr;
  51   
  52  alias(r,rr);
  53  market_clearing(r)..
  54      Qs(r)
  55      + sum(rr$(not sameas(rr,"USA")), X(rr))$sameas(r,"USA")
  56      + Xcr$sameas(r,"ROW")
  57      =g=
  58      Qd(r)
  59      + X(r)$(not sameas(r,"USA"))
  60      + Xcr$sameas(r,"China");
  61   
  62  * Solve the welfare problem first to initialize the MCP.
  63  model simple /all/;
  64  solve simple using QCP maximizing W;
  65   
  66  set scenario /BAU/;
  67  set metric /Qd, Qs, P, Exports/;
  68  parameter rep(scenario,metric,r);
  69  rep("BAU","Qd",r) = Qd.l(r);
  70  rep("BAU","Qs",r) = Qs.l(r);
  71  rep("BAU","P",r) = -market_clearing.m(r);
  72  rep("BAU","Exports",r) = X.l(r);
  73  execute_unload 'rep_graphite_mcp.gdx' ;
  74   
  75  positive variable P(r) ;
  76  equation foc_qs(r), foc_qd(r), foc_x(r) ;
  77   
  78  foc_qs(r).. c(r) + d(r) * Qs(r) =g= P(r) ;
  79  foc_qd(r)..   P(r) =g= a(r)+b(r)*Qd(r) ;
  80  foc_x(r)$(not sameas(r,"USA"))..
  81      tradeCost(r) + P(r) =g= P("USA");
  82  equation foc_xcr;
  83  foc_xcr.. tradeCostChinaROW + P("China") =g= P("ROW");
  84   
  85  model graphite_mcp /
  86      market_clearing.P,
  87      foc_qs.Qs,
  88      foc_qd.Qd,
  89      foc_x.X,
  90      foc_xcr.Xcr
  91  /;
  92   
  93  P.l(r) = max(0, -market_clearing.m(r));
  94  solve graphite_mcp using MCP;
  95   
  96  parameter results(*,*,r);
  97  parameter welfare(*);
  98  * Record the MCP baseline.
  99  results("Baseline","Price",r)   = P.l(r);
 100  results("Baseline","Demand",r)  = Qd.l(r);
 101  results("Baseline","Supply",r)  = Qs.l(r);
 102  results("Baseline","Exports",r) = X.l(r);
 103   
 104  welfare("Baseline") =
 105      sum(r,
 106          a(r)*Qd.l(r) + b(r)*sqr(Qd.l(r))/2
 107          - c(r)*Qs.l(r) - d(r)*sqr(Qs.l(r))/2
 108      )
 109      - sum(r, tradeCost(r)*X.l(r));
 110   
 111  * Milestone 1 | Chinese natural graphite production expansion
 112  set productionShock /S10, S20, S30, S40/;
 113  parameter shockPct(productionShock) /
 114      S10 0.10, S20 0.20, S30 0.30, S40 0.40
 115  /;
 116   
 117  scalar baselineChinaProduction;
 118  parameter targetProduction(productionShock);
 119  baselineChinaProduction = Qs.l("China");
 120   
 121  * Re-solve the QCP and MCP for each production shock.
 122  loop(productionShock,
 123      Qs.fx("China") = baselineChinaProduction*(1+shockPct(productionShock));
 124      targetProduction(productionShock) = baselineChinaProduction*(1+shockPct(productionShock));
 125      solve simple using QCP maximizing W;
 126      P.l(r) = max(0,-market_clearing.m(r));
 127      solve graphite_mcp using MCP;
 128      results(productionShock,"Price",r) = P.l(r);
 129      results(productionShock,"Demand",r) = Qd.l(r);
 130      results(productionShock,"Supply",r) = Qs.l(r);
 131      results(productionShock,"Exports",r) = X.l(r);
 132   
 133  * Calculate the original Milestone 1 welfare report.
 134      welfare(productionShock) =
 135          sum(r,
 136              a(r)*Qd.l(r)
 137              + b(r)*sqr(Qd.l(r))/2
 138              - c(r)*Qs.l(r)
 139              - d(r)*sqr(Qs.l(r))/2
 140          )
 141          - sum(r,tradeCost(r)*X.l(r));
 142  );
 143   
 144  Qs.lo("China") = 0;
 145  Qs.up("China") = +inf;
 146   
 147  display baselineChinaProduction;
 148  display targetProduction;
 149  display results;
 150  display welfare;
 151   
 152  execute_unload 'graphite_milestone1.gdx';
 153   
 154  * Milestone 2 | Natural and synthetic graphite substitution
 155  set g /natural, synthetic/;
 156  set china2 /C00, C10, C20, C30, C40/;
 157  parameter chinaPct2(china2) /
 158      C00 0, C10 0.10, C20 0.20, C30 0.30, C40 0.40
 159  /;
 160  set syn2 /T00, T10, T20, T30/;
 161  parameter synPct2(syn2) /
 162      T00 0, T10 0.10, T20 0.20, T30 0.30
 163  /;
 164   
 165  * Illustrative natural and synthetic baseline shares.
 166  parameter share2(g) /
 167      natural 0.70, synthetic 0.30
 168  /;
 169   
 170  parameter qbar_s2(r,g);
 171  parameter c2(r,g), d2(r,g);
 172  parameter weight2(g);
 173  qbar_s2(r,g) = qbar_s(r)*share2(g)/share2("natural");
 174   
 175  * Calibrate the supply curve for each product.
 176  d2(r,g)$(qbar_s2(r,g)>0) = pbar(r)/(e_s*qbar_s2(r,g));
 177  c2(r,g)$(qbar_s2(r,g)>0) = pbar(r)-d2(r,g)*qbar_s2(r,g);
 178  c2("USA","natural") = 100;
 179  d2("USA","natural") = 2;
 180  c2("USA","synthetic") = 110;
 181  d2("USA","synthetic") = 2;
 182   
 183  * Calibrate the demand curve for the CES basket.
 184  scalar epsCES /0.0001/;
 185  parameter qbar_d2(r,g), gbarCES(r), aCES(r), bCES(r);
 186   
 187  qbar_d2(r,g) = qbar_d(r)*share2(g)/share2("natural");
 188  gbarCES(r)   = sum(g, qbar_d2(r,g)) + epsCES;
 189  bCES(r) = pbar(r)/(e_d*gbarCES(r));
 190  aCES(r) = pbar(r) - bCES(r)*gbarCES(r);
 191  scalar weightDenom;
 192   
 193  positive variables
 194      QdCES(r,g)
 195      QsCES(r,g)
 196      XCES(r,g)
 197      XcrCES(g)
 198      GCES(r);
 199  variable WCES;
 200   
 201  equations
 202      cesDemand(r)
 203      objCES
 204      marketCES(r,g);
 205   
 206  cesDemand(r)..
 207      GCES(r) =e=
 208      sqr(weight2("natural")*sqrt(QdCES(r,"natural")+epsCES)
 209          + weight2("synthetic")*sqrt(QdCES(r,"synthetic")+epsCES));
 210   
 211  objCES..
 212      WCES =e=
 213      sum(r,
 214          aCES(r)*GCES(r)
 215          + bCES(r)*sqr(GCES(r))/2
 216      )
 217      -
 218      sum((r,g),
 219          c2(r,g)*QsCES(r,g)
 220          + d2(r,g)*sqr(QsCES(r,g))/2
 221          + tradeCost(r)*XCES(r,g)
 222      )
 223      - tradeCostChinaROW*sum(g, XcrCES(g));
 224   
 225  marketCES(r,g)..
 226      QsCES(r,g)
 227      + sum(rr$(not sameas(rr,"USA")),XCES(rr,g))
 228          $sameas(r,"USA")
 229      + XcrCES(g)$sameas(r,"ROW")
 230      =e=
 231      QdCES(r,g)
 232      + XCES(r,g)$(not sameas(r,"USA"))
 233      + XcrCES(g)$sameas(r,"China");
 234   
 235  model graphite_CES / cesDemand objCES marketCES /;
 236   
 237  * Initialize and solve the baseline with no U.S. production.
 238  QsCES.fx("USA",g) = 0;
 239  XCES.fx("USA",g) = 0;
 240  weight2(g) = sqrt(share2(g));
 241   
 242  * Illustrative U.S. cost curve used in Milestone 2.
 243  c2("USA","natural") = 10;
 244  d2("USA","natural") = 2;
 245  QdCES.l(r,g) = qbar_d(r)*share2(g);
 246  QsCES.l(r,g) = qbar_s(r)*share2(g);
 247  GCES.l(r) = qbar_d(r);
 248   
 249  solve graphite_CES using NLP maximizing WCES;
 250  abort$(graphite_CES.modelStat <> 1 and graphite_CES.modelStat <> 2)
 251      "Milestone 2 baseline did not solve";
 252   
 253  scalar baselineChinaNatural;
 254  baselineChinaNatural = QsCES.l("China","natural");
 255   
 256  * Apply the production shocks and synthetic preference shifts.
 257  parameter M2results(china2,syn2,*);
 258  parameter qsces_rep ;
 259  loop(china2,
 260      QsCES.fx("China","natural") = baselineChinaNatural*(1 + chinaPct2(china2));
 261   
 262      loop(syn2,
 263          qsces_rep(china2,syn2,"qsces") = QsCES.l("China","natural") ;
 264   
 265  * Increase and normalize the synthetic preference weight.
 266          weightDenom = sqrt(
 267              share2("natural")
 268              + share2("synthetic")*sqr(1+synPct2(syn2))
 269          );
 270          weight2("natural") = sqrt(share2("natural"))/weightDenom;
 271          weight2("synthetic") = sqrt(share2("synthetic")) *(1+synPct2(syn2))/weightDenom;
 272   
 273          qsces_rep(china2,syn2,"natural") = weight2("natural") ;
 274          qsces_rep(china2,syn2,"synthetic") = weight2("synthetic") ;
 275   
 276  * The second solve starts from the first solution.
 277          solve graphite_CES using NLP maximizing WCES;
 278          solve graphite_CES using NLP maximizing WCES;
 279          abort$(graphite_CES.modelStat <> 1 and graphite_CES.modelStat <> 2)
 280              "Milestone 2 scenario did not solve";
 281   
 282  * Record demand, prices, supply, trade, and welfare.
 283          M2results(china2,syn2,"US_Natural_Demand") = QdCES.l("USA","natural");
 284          M2results(china2,syn2,"US_Synthetic_Demand") = QdCES.l("USA","synthetic");
 285          M2results(china2,syn2,"US_Natural_Price") = -marketCES.m("USA","natural");
 286          M2results(china2,syn2,"US_Synthetic_Price") = -marketCES.m("USA","synthetic");
 287          M2results(china2,syn2,"China_Natural_Supply") = QsCES.l("China","natural");
 288          M2results(china2,syn2,"China_Synthetic_Supply") = QsCES.l("China","synthetic");
 289          M2results(china2,syn2,"China_Natural_Exports") = XCES.l("China","natural");
 290          M2results(china2,syn2,"China_Synthetic_Exports") = XCES.l("China","synthetic");
 291          M2results(china2,syn2,"US_Synthetic_Share") =
 292              QdCES.l("USA","synthetic")
 293              / max(epsCES,sum(g,QdCES.l("USA",g)));
 294          M2results(china2,syn2,"Welfare") = WCES.l;
 295   
 296      );
 297  );
 298   
 299  display baselineChinaNatural;
 300  display M2results;
 301  execute_unload 'graphite_milestone2.gdx' ;
 302   
 303  * Milestone 3 | Competition and U.S. entry
 304  option limrow=0, limcol=0, solprint=off;
 305   
 306  set shock3 /Base, S10, S20, S30, S40/;
 307  parameter shockPct3(shock3) /Base 0, S10 0.10, S20 0.20,
 308   S30 0.30, S40 0.40/;
 309  set entry3 /NoEntry, Entry/;
 310   
 311  scalar
 312      fixedCost3 /6238.61/
 313      USCapacity3 /11.29/
 314      ChinaBase3
 315      ChinaWTP3;
 316   
 317  parameter
 318      price3(r,g)
 319      report3(shock3,entry3,*)
 320      decision3(shock3,*);
 321   
 322  * Restore baseline CES preferences and production bounds.
 323  weight2(g) = sqrt(share2(g));
 324   
 325  * Costs for the potential U.S. entrant.
 326  c2("USA","natural") = 610;
 327  d2("USA","natural") = 2;
 328  fixedCost3 = 6238.61;
 329   
 330  QsCES.lo("China","natural") = 0;
 331  QsCES.up("China","natural") = +inf;
 332  QsCES.fx("USA",g) = 0;
 333   
 334  solve graphite_CES using NLP maximizing WCES;
 335  abort$(graphite_CES.modelStat <> 1 and graphite_CES.modelStat <> 2)
 336     "Milestone 3 baseline failed";
 337   
 338  ChinaBase3 = QsCES.l("China","natural");
 339   
 340  * Compare no-entry and entry equilibria at each Chinese output level.
 341  loop(shock3,
 342      QsCES.fx("China","natural") = ChinaBase3*(1+shockPct3(shock3));
 343   
 344      loop(entry3,
 345  * Enable U.S. natural graphite production only in the entry case.
 346          QsCES.lo("USA","natural") = 0;
 347          QsCES.up("USA","natural") = 0;
 348          if(sameas(entry3,"Entry"),
 349              QsCES.up("USA","natural") = USCapacity3;
 350          );
 351   
 352          solve graphite_CES using NLP maximizing WCES;
 353          abort$(graphite_CES.modelStat <> 1 and graphite_CES.modelStat <> 2)
 354             "Milestone 3 scenario failed";
 355   
 356          price3(r,g) = max(0,-marketCES.m(r,g));
 357   
 358  * Record U.S. price, output, and net profit.
 359          report3(shock3,entry3,"US_Price") = price3("USA","natural");
 360          report3(shock3,entry3,"US_Production") = QsCES.l("USA","natural");
 361          report3(shock3,entry3,"US_Net_Profit") =
 362              price3("USA","natural") *QsCES.l("USA","natural")
 363              -c2("USA","natural") *QsCES.l("USA","natural")
 364              -d2("USA","natural") *sqr(QsCES.l("USA","natural"))/2
 365              -fixedCost3$sameas(entry3,"Entry");
 366   
 367  * Record Chinese producer profit.
 368          report3(shock3,entry3,"China_Profit") =
 369              sum(g,
 370                  price3("China",g) *QdCES.l("China",g)
 371                  +(price3("USA",g) -tradeCost("China")) *XCES.l("China",g)
 372                  -c2("China",g) *QsCES.l("China",g)
 373                  -d2("China",g) *sqr(QsCES.l("China",g))/2
 374              );
 375   
 376  * Record Chinese and global welfare.
 377          report3(shock3,entry3,"China_Welfare") =
 378              a("China")*GCES.l("China")
 379              +b("China") *sqr(GCES.l("China"))/2
 380              -sum(g, price3("China",g) *QdCES.l("China",g) )
 381              +report3(shock3,entry3,"China_Profit");
 382   
 383          report3(shock3,entry3,"Global_Welfare") =
 384              WCES.l
 385              -fixedCost3$sameas(entry3,"Entry");
 386   
 387      );
 388   
 389  * Entry requires positive net profit and production.
 390      decision3(shock3,"US_Enters") = (report3(shock3,"Entry","US_Net_Profit") > 0)
 391          and
 392          (report3(shock3,"Entry","US_Production") > 0.0001);
 393   
 394  );
 395   
 396  * Compare Chinese profits and welfare with the no-entry baseline.
 397  decision3(shock3,"China_Profit_Loss") =
 398      report3("Base","NoEntry","China_Profit")
 399      - report3(shock3,"NoEntry","China_Profit");
 400   
 401  decision3(shock3,"China_Welfare_Loss") =
 402      report3("Base","NoEntry","China_Welfare")
 403      - report3(shock3,"NoEntry","China_Welfare");
 404   
 405  * Evaluate the profit gain from preventing entry.
 406  ChinaWTP3 = max(0,
 407      report3("Base","NoEntry","China_Profit")
 408      -report3("Base","Entry","China_Profit")
 409  );
 410   
 411  decision3(shock3,"Deters_Entry") = decision3("Base","US_Enters")
 412      *(1-decision3(shock3,"US_Enters"));
 413   
 414  decision3(shock3,"Worth_Deterring") = (decision3(shock3,"Deters_Entry") > 0)
 415      and
 416      (decision3(shock3,"China_Profit_Loss") <= ChinaWTP3);
 417   
 418  * Find the lowest profit sacrifice among shocks that deter entry.
 419  scalar
 420      CanDeter3
 421      MinDeterrenceCost3
 422      DeterrenceWorthIt3;
 423   
 424  CanDeter3 = sum( shock3$(decision3(shock3,"Deters_Entry") > 0), 1 );
 425   
 426  MinDeterrenceCost3 = 0;
 427  if(CanDeter3 > 0,
 428      MinDeterrenceCost3 = smin(
 429          shock3$(decision3(shock3,"Deters_Entry") > 0),
 430          decision3(shock3,"China_Profit_Loss")
 431      );
 432  );
 433   
 434  DeterrenceWorthIt3 = 0;
 435  if(CanDeter3 > 0,
 436      DeterrenceWorthIt3 = (MinDeterrenceCost3 <= ChinaWTP3);
 437  );
 438   
 439  display CanDeter3, MinDeterrenceCost3, ChinaWTP3, DeterrenceWorthIt3;
 440  * Preserve the listing's repeated display of the deterrence results.
 441  display CanDeter3, MinDeterrenceCost3, ChinaWTP3, DeterrenceWorthIt3;
 442   
 443  display ChinaBase3, report3, decision3, ChinaWTP3;
 444   
 445  execute_unload 'graphite_milestone3.gdx' ;
